# ===========================================
# Configuração Jira
# ===========================================
# URL base da sua instância Jira (ex: https://sua-empresa.atlassian.net)
JIRA_BASE_URL=

# Email da conta Atlassian
JIRA_EMAIL=

# API Token: gere em https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# ===========================================
# Configuração GitHub
# ===========================================
# Personal Access Token: gere em https://github.com/settings/tokens
# Permissões necessárias: repo, read:user, read:org
GITHUB_TOKEN=

# ===========================================
# Configuração GitLab
# ===========================================
# URL base (padrão: https://gitlab.com). Para self-hosted: https://gitlab.sua-empresa.com
GITLAB_URL=

# Personal Access Token: gere em GitLab > Preferences > Access Tokens
# Permissões: read_api, read_user
GITLAB_TOKEN=

# ===========================================
# Opcional: usuário específico para consultas
# ===========================================
# Deixe em branco para usar o usuário autenticado
JIRA_USER_EMAIL=
GITHUB_USERNAME=
GITLAB_USERNAME=
